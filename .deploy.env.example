# Tutifrutsy FTP deploy settings
# Copy this file to .deploy.env and fill in FTP_PASSWORD, or leave
# FTP_PASSWORD blank and the deploy script will ask for it securely.

FTP_HOST=ftp.tutifrutsy.com
FTP_PORT=21
FTP_USERNAME=admin@tutifrutsy.com
FTP_PASSWORD=

# Deploy directly to the live web root for tutifrutsy.com.
# Do not deploy to / because that is the SiteGround account root.
FTP_REMOTE_DIR=/tutifrutsy.com/public_html
FTP_LOCAL_DIR=.

# Keep this on unless SiteGround rejects explicit FTPS.
FTP_TLS=1

# These remote files/folders are never deleted by --prune.
FTP_PROTECTED_PATHS=.env,.ftpquota,.well-known,.well-known/*,cgi-bin,cgi-bin/*,logs,logs/*,webstats,webstats/*

# These local files/folders are never uploaded.
FTP_EXCLUDE=.env,.deploy.env,.deploy.env.example,.DS_Store,.gitignore,.git,.git/*,.claude,.claude/*,__pycache__,*.pyc,*.md,scripts,scripts/*
